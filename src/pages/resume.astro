---
import Layout from "../layouts/Layout.astro";

const skills = [
  "React",
  "TypeScript",
  "Vue.js / Nuxt.js",
  "Redux Toolkit / RTK Query",
  "Zustand",
  "HTML / CSS / TailwindCSS",
  "Vite / Webpack",
  "PHP / Laravel",
  "Node.js",
  "REST API",
  "Feature-Sliced Design",
  "VeeValidate / Zod",
  "Vitest / React Testing Library",
  "Performance Optimization",
];

const extras = [
  "Git",
  "Code Review",
  "Mentorship",
  "AI-Assisted Development (Claude Code, agent workflows)",
];

const metrics = [
  { value: "6+", label: "лет коммерческой разработки" },
  { value: "−35%", label: "время отклика UI (ERP)" },
  { value: "−60%", label: "ошибок ввода (телемедицина)" },
  { value: "−30%", label: "время загрузки (маркетплейс)" },
];

const experience = [
  {
    title: "Телемедицинская платформа для врачей и пациентов",
    domain: "Healthtech",
    stack:
      "Vue 3, Nuxt 4, TypeScript, TailwindCSS, Vite, VeeValidate, Zod, PrimeVue",
    headline: "Снизил количество ошибок ввода на 60%",
    headlineDetail:
      "спроектировав модуль динамических форм с условной валидацией (VeeValidate + Zod) — в медицинских данных ошибка ввода не косметика, а риск для пациента и повторное обращение в поддержку.",
    bullets: [
      "Полностью исключил вылеты пользовательских сессий (автообновление access/refresh токенов через HTTP-интерцептор с очередью запросов) — для сервиса, где врач ведёт приём, разлогин на середине действия это потерянное время и недоверие к продукту.",
      "Сократил время разработки новых экранов в 2 раза, спроектировав переиспользуемый UI-Kit на PrimeVue + TailwindCSS с темизацией через CSS-токены.",
      "Внедрил поддержку тёмной темы.",
    ],
  },
  {
    title: "ERP-система для строительных организаций",
    domain: "Enterprise / ERP",
    stack:
      "React, TypeScript, Redux, RTK Query, TailwindCSS, React Intl, HeadlessUI, Feature-Sliced Design",
    headline: "Снизил время отклика интерфейса на 35%",
    headlineDetail:
      "оптимизировав рендер тяжёлых таблиц и деревьев — в ERP с этим интерфейсом сотрудники работают каждый день, и лишняя секунда на каждом экране умножается на сотни операций в смену.",
    bullets: [
      "Сократил объём кода на 25% и убрал ручную инвалидацию кэша, переведя загрузку серверных данных на RTK Query.",
      "Спроектировал архитектуру клиентской части на Feature-Sliced Design для команды из 5 фронтенд-разработчиков — исключил скрытые зависимости между сущностями при росте проекта.",
      "Реализовал сложные интерфейсы для вложенных сущностей: таблицы с глубокой фильтрацией, древовидные структуры, иерархические формы.",
    ],
  },
  {
    title: "Маркетплейс СТО и механиков (карта + подписка)",
    domain: "Marketplace",
    stack:
      "React 19, TypeScript, TailwindCSS, Vite, Inertia.js, HeadlessUI, MapLibre, Zustand, Turf.js, PayPal",
    headline: "Сократил время загрузки страниц на 30%",
    headlineDetail:
      "через code splitting и ленивую загрузку карты (MapLibre) — на главном экране маркетплейса это прямо решает, останется пользователь искать СТО или уйдёт на первом экране.",
    bullets: [
      "Оптимизировал загрузку точек на карте: фронтенд передаёт bounding box видимой области, бэкенд отдаёт только точки внутри неё.",
      "Интегрировал приём платежей по подписке через PayPal end-to-end — от инициации до подтверждения статуса.",
      "Спроектировал главный экран на интерактивной карте (MapLibre) как основной сценарий поиска.",
    ],
  },
  {
    title: "Интернет-магазин доставки фастфуда",
    domain: "E-commerce",
    stack: "Vue 2, Vuex, SCSS, Axios, Laravel (backend)",
    headline: "Снизил число запросов к серверу на 40%",
    headlineDetail:
      "кэшируя каталог товаров и категории в сторе Vuex вместо повторных запросов при каждой навигации — прямая экономия на инфраструктуре без изменений на бэкенде.",
    bullets: [
      "Реализовал полную бизнес-логику товаров: корзину, оформление заказов, динамическую фильтрацию.",
      "Настроил интеграцию с Laravel-бэкендом через REST API.",
    ],
  },
  {
    title: "Telegram Mini App (игровое приложение)",
    domain: "Gaming",
    stack: "Next.js (SSR/SPA), Supabase (PostgreSQL), Telegram WebApp API",
    headline: "Поддержка и развитие продакшен-приложения",
    headlineDetail:
      "рефакторинг легаси-кода, интеграция с Supabase и Telegram WebApp API для данных пользователей и игровой статистики.",
    bullets: [],
  },
];
---

<Layout
  title="Ilya Murzalev — Resume"
  metaDescription="Senior Frontend Engineer (React/TypeScript, Vue/Nuxt) resume — 6+ years building ERP systems, marketplaces and complex SPAs."
>
  <main class="resume">
    <button class="print-button no-print" id="print-btn" type="button">
      Скачать PDF
    </button>

    <header class="resume-header">
      <h1 class="name">Илья Мурзалев</h1>
      <p class="title">Senior Frontend Engineer (React/TypeScript, Vue/Nuxt)</p>
      <p class="tagline">
        Проектирую интерфейсы так, чтобы решения были измеримы в деньгах и
        времени бизнеса, а не только в красоте кода.
      </p>
      <ul class="contacts">
        <li>
          <a
            class="link"
            href="https://t.me/ilha_wd"
            target="_blank"
            rel="noopener noreferrer"
          >
            Telegram: @ilha_wd
          </a>
        </li>
        <li>
          <a class="link" href="mailto:ilha9749@gmail.com">
            ilha9749@gmail.com
          </a>
        </li>
        <li>
          <a
            class="link"
            href="https://murzalev-labs.ru"
            target="_blank"
            rel="noopener noreferrer"
          >
            murzalev-labs.ru
          </a>
        </li>
        <li>Москва · удалённо</li>
      </ul>
    </header>

    <section class="summary">
      <p>
        Каждое архитектурное решение оцениваю через то, что оно даёт бизнесу:
        меньше отказов на загрузке, меньше ошибок в форме, меньше нагрузки на
        сервер, быстрее выход новых фич для команды. Не просто пишу
        React/Vue-код по макету — нахожу, где интерфейс теряет пользователей или
        замедляет команду, и закрываю это измеримым решением. Основной стек —{" "}
        <strong>React, TypeScript, Redux Toolkit</strong>, также уверенно
        работаю с Vue.js/Nuxt.js и читаю backend-код (PHP/Laravel), что упрощает
        согласование контрактов с backend-командой.
      </p>
    </section>

    <section class="metrics-section">
      <ul class="metrics">
        {metrics.map((metric) => (
          <li class="metric">
            <span class="metric-value">{metric.value}</span>
            <span class="metric-label">{metric.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="section-heading">Опыт</h2>
      {experience.map((job) => (
        <article class="job">
          <div class="job-head">
            <h3 class="job-title">{job.title}</h3>
            <span class="domain-tag">{job.domain}</span>
          </div>
          <p class="job-stack">{job.stack}</p>
          <p class="job-headline">
            <span class="job-headline-value">{job.headline}</span> —{" "}
            {job.headlineDetail}
          </p>
          {job.bullets.length > 0 && (
            <ul class="job-bullets">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </section>

    <section>
      <h2 class="section-heading">Навыки</h2>
      <ul class="tags-list">
        {skills.map((skill) => (
          <li class="tags-list__item">{skill}</li>
        ))}
      </ul>
    </section>

    <section class="secondary-section">
      <h2 class="section-heading section-heading--secondary">
        Также приношу в команду
      </h2>
      <ul class="tags-list">
        {extras.map((item) => (
          <li class="tags-list__item tags-list__item--ghost">{item}</li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<script>
  document.getElementById("print-btn")?.addEventListener("click", () => {
    window.print();
  });
</script>

<style>
  .resume {
    margin: auto;
    padding: var(--page-padding);
    max-width: var(--content-width);
  }
  .print-button {
    float: right;
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid rgba(var(--accent), 0.5);
    background: rgba(var(--accent), 0.12);
    color: #111;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .print-button:hover {
    background: rgba(var(--accent), 0.25);
  }
  .resume-header {
    clear: both;
    margin-bottom: 1.5rem;
  }
  .name {
    font-size: var(--fs-h1-case);
    font-weight: 800;
    margin: 0 0 0.25rem;
  }
  .title {
    font-size: var(--fs-body);
    color: #444;
    margin: 0 0 0.4rem;
  }
  .tagline {
    font-size: 0.95rem;
    font-weight: 600;
    color: rgb(var(--accent));
    margin: 0 0 0.9rem;
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.95rem;
    color: #444;
  }
  .summary {
    font-size: var(--fs-body);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .summary strong {
    font-weight: 700;
  }
  section {
    margin: 2rem 0;
  }
  .metrics-section {
    margin: 1.5rem 0 2.5rem;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 14px;
    border-radius: 10px;
    background: rgba(var(--accent), 0.1);
    border: 1px solid rgba(var(--accent), 0.3);
  }
  .metric-value {
    font-size: 1.6rem;
    font-weight: 800;
    color: #111;
  }
  .metric-label {
    font-size: 0.78rem;
    color: #555;
    line-height: 1.3;
  }
  .section-heading {
    font-size: var(--fs-h2);
    font-weight: 800;
    margin: 0 0 1rem;
  }
  .section-heading--secondary {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #666;
  }
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags-list__item {
    padding: 8px 16px;
    border-radius: 8px;
    background-image: var(--accent-gradient);
    background-size: 400%;
    background-position: 0%;
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .tags-list__item--ghost {
    background: transparent;
    border: 1px solid #ccc;
    color: #555;
    font-weight: 500;
    font-size: 0.85rem;
    padding: 5px 13px;
  }
  .job {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e3e3e3;
  }
  .job:last-child {
    border-bottom: none;
  }
  .job-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .job-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
  }
  .domain-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #777;
    padding: 2px 8px;
    border: 1px solid #ccc;
    border-radius: 999px;
  }
  .job-stack {
    font-size: 0.85rem;
    color: #666;
    margin: 0.3rem 0 0.75rem;
  }
  .job-headline {
    margin: 0 0 0.6rem;
    padding: 10px 14px;
    border-left: 3px solid rgb(var(--accent));
    background: rgba(var(--accent), 0.07);
    border-radius: 0 6px 6px 0;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .job-headline-value {
    font-weight: 800;
    color: #111;
  }
  .job-bullets {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.55;
  }
  .job-bullets li {
    margin-bottom: 0.4rem;
  }

  @media (max-width: 640px) {
    .metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media print {
    .no-print {
      display: none !important;
    }
    .resume {
      max-width: none;
      padding: 0;
    }
    .metrics {
      grid-template-columns: repeat(4, 1fr);
    }
    .metric {
      background: #f3f3f3;
      border: 1px solid #ccc;
    }
    .job-headline {
      background: #f3f3f3;
      border-left: 3px solid #111;
    }
    .tagline {
      color: #111;
    }
    .tags-list__item {
      background-image: none;
      background-color: #eee;
      color: #111;
      border: 1px solid #ccc;
    }
    .job {
      break-inside: avoid;
    }
    a {
      color: #111 !important;
    }
  }
</style>
