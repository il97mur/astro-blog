---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

import { getCollection } from 'astro:content';
import SkillsList from '../components/skills/SkillsList.astro';

const projects = await getCollection('projects');
---

<Layout
	title="Ilya Murzalev — Senior Frontend Engineer"
	metaDescription="Senior Frontend Engineer (React/TypeScript, Vue/Nuxt), 6+ years of experience building ERP systems, marketplaces and complex SPAs. Portfolio and case studies."
>
	<main>
		<h1>Hello.</h1>
		<p class="text-lg font-medium">My name is Ilya Murzalev.</p>
		<p class="text-lg font-medium">And I'm a <span class="text-gradient">senior frontend engineer.</span></p>
		<p class="text-medium">
			6+ years of commercial experience building
			complex SPAs and admin panels: ERP systems, marketplaces, internal tools.
			Primary stack: React, TypeScript, Redux Toolkit. Also comfortable with Vue.js, Nuxt.js,
			and reading backend code (PHP/Laravel), which helps me work closely with backend engineers.
		</p>
		<p class="text-medium">
			Below you can see the list of projects that I worked on:
		</p>
		<ul role="list" class="projects-list">
			{projects.map(project => (
				<Card
					title={project.data.title}
					body={project.data.description}
					href={`/projects/${project.slug}`}
					badges={project.data.technologies}
				/>
			))}
		</ul>

		<section>
			<h2>My skills</h2>
			<SkillsList />
		</section>
	</main>
</Layout>

<style>
	main {
		margin: auto;
		padding: 1.5rem;
		max-width: 800px;
	}
	h1 {
		font-size: 3rem;
		font-weight: 800;
		margin: 0;
	}
	section {
		margin: 3rem 0;
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	.text-lg {
		font-size: 2.3rem;
	}
	.text-medium {
		font-size: 1.5rem;
	}
	.font-medium {
		font-weight: 500;
	}
	.projects-list {
		display: grid;
		gap: 20px 35px;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		list-style: none;
		padding: 0;
		margin: 0;
	}
</style>
