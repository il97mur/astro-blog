---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

import { getCollection } from "astro:content";
import SkillsList from "../components/skills/SkillsList.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Ilya Murzalev — Senior Frontend Engineer"
  metaDescription="Senior Frontend Engineer (React/TypeScript, Vue/Nuxt), 6+ years of experience building ERP systems, marketplaces and complex SPAs. Portfolio and case studies."
>
  <main>
    <p class="eyebrow">Hello, I'm</p>
    <h1 class="display">
      Ilya Murzalev —{" "}
      <span class="text-gradient">Senior Frontend Engineer</span>
    </h1>
    <p class="status-badge">
      <span class="status-badge__dot" aria-hidden="true"></span>
      Open to new opportunities
    </p>
    <p class="text-body">
      6+ years of commercial experience building complex SPAs and admin panels:
      ERP systems, marketplaces, internal tools. Primary stack:{" "}
      <strong class="highlight">React, TypeScript, Redux Toolkit</strong>. Also
      comfortable with Vue.js, Nuxt.js, and reading backend code (PHP/Laravel),
      which helps me work closely with backend engineers.
    </p>
    <a class="cta-button" href="mailto:ilha9749@gmail.com">
      Get in touch <span aria-hidden="true">&rarr;</span>
    </a>

    <p class="text-body">
      Below you can see the list of projects that I worked on:
    </p>
    <ul role="list" class="projects-list">
      {projects.map((project) => (
        <Card
          title={project.data.title}
          body={project.data.description}
          href={`/projects/${project.slug}`}
          badges={project.data.technologies}
        />
      ))}
    </ul>

    <section>
      <h2 class="skills-heading">My skills</h2>
      <SkillsList />
    </section>

    <section class="secondary-section">
      <h2 class="secondary-heading">Also bring to the team</h2>
      <ul class="tags-list">
        <li class="tags-list__item tags-list__item--ghost">Git</li>
        <li class="tags-list__item tags-list__item--ghost">Code Review</li>
        <li class="tags-list__item tags-list__item--ghost">Mentorship</li>
        <li class="tags-list__item tags-list__item--ghost">
          Backend Literacy (REST API, MVC)
        </li>
        <li class="tags-list__item tags-list__item--ghost">
          AI-Assisted Development (Claude Code, agent workflows)
        </li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding: var(--page-padding);
    max-width: var(--content-width);
  }
  .eyebrow {
    font-size: var(--fs-eyebrow);
    font-weight: 500;
    color: #666;
    margin: 0 0 0.25rem;
  }
  .display {
    font-size: var(--fs-display);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1rem;
  }
  section {
    margin: 3rem 0;
  }
  .secondary-section {
    margin-top: 2rem;
  }
  .skills-heading {
    font-size: var(--fs-h2);
    font-weight: 800;
    margin: 0 0 1rem;
  }
  .secondary-heading {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #666;
    margin: 0 0 1rem;
  }
  .text-gradient,
  .highlight {
    background-image: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 400%;
    background-position: 0%;
    /* Clones the gradient per wrapped line instead of stretching one gradient across all lines' combined box. */
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .highlight {
    font-weight: 700;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid #ccc;
    color: #444;
    font-size: 0.9rem;
    font-weight: 500;
    margin: 0 0 1.25rem;
  }
  .status-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(var(--accent));
    flex-shrink: 0;
  }
  .text-body {
    font-size: var(--fs-body);
    line-height: 1.6;
    margin: 0 0 1rem;
  }
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 8px;
    background-color: rgba(var(--accent), 0.12);
    background-image: none;
    background-size: 400%;
    background-position: 100%;
    border: 1px solid rgba(var(--accent), 0.5);
    color: #111;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition:
      background-position 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    margin: 0 0 1.5rem;
  }
  .cta-button:hover,
  .cta-button:focus-visible {
    background-color: transparent;
    background-image: var(--accent-gradient);
    background-position: 0%;
    border-color: transparent;
    color: #fff;
  }
  .projects-list {
    display: grid;
    gap: 20px 35px;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags-list__item {
    padding: 6px 14px;
    border-radius: 8px;
    background: rgba(var(--accent), 0.15);
    font-size: 0.95rem;
  }
  .tags-list__item--ghost {
    background: transparent;
    border: 1px solid #ccc;
    color: #555;
    font-size: 0.85rem;
    padding: 5px 13px;
  }
</style>
