---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const projectsCollection = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return projectsCollection.map((entry, index) => {
    const nextEntry =
      projectsCollection[(index + 1) % projectsCollection.length];
    return {
      params: { slug: entry.slug },
      props: { entry, nextEntry },
    };
  });
}
// 2. When it's time to render, you can get the entry directly from the prop
const { entry, nextEntry } = Astro.props;
const { Content } = await entry.render();
---

<Layout
  title={`Projects - ${entry.data.title}`}
  metaDescription={entry.data.description}
>
  <main>
    <a class="link back-link" href="/">
      <span>&larr;</span>
      Go back
    </a>

    <div class="case-study">
      <Content />
    </div>
    {entry.data.technologies && (
      <>
        <h2 class="technologies-title">Technologies</h2>
        <ul class="technologies-list">
          {entry.data.technologies.map((tech) => (
            <li class="technologies-list__item"> {tech} </li>
          ))}
        </ul>
      </>
    )}
    {nextEntry.slug !== entry.slug && (
      <a class="link next-project" href={`/projects/${nextEntry.slug}`}>
        <span class="next-project__label">Next project</span>
        <span class="next-project__title">{nextEntry.data.title} &rarr;</span>
      </a>
    )}
  </main>
</Layout>

<style lang="scss">
  main {
    max-width: 800px;
    margin: auto;
    padding: 1.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.95rem;
  }
  .case-study {
    margin-top: 1.5rem;

    :global(h1) {
      font-size: 2.25rem;
      font-weight: 800;
      line-height: 1.2;
      margin: 0 0 1.25rem;
    }
    :global(p) {
      font-size: 1.125rem;
      line-height: 1.65;
      color: #333;
      margin: 0 0 1.1rem;
    }
    :global(ul) {
      margin: 0 0 1.1rem;
      padding-left: 1.25rem;
    }
    :global(li) {
      font-size: 1.125rem;
      line-height: 1.65;
      color: #333;
      margin-bottom: 0.4rem;
    }
    :global(strong) {
      font-weight: 700;
      background-image: var(--accent-gradient);
      background-size: 400%;
      background-position: 0%;
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }
  .technologies-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 2rem 0 1rem;
  }
  .technologies-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 0;
    padding: 0;

    &__item {
      list-style: none;
      padding: 4px 14px;
      border-radius: 8px;
      background: transparent;
      border: 1px solid #ccc;
      color: #555;
    }
  }
  .next-project {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e5e5;

    &__label {
      font-size: 0.9rem;
      color: #666;
    }

    &__title {
      font-size: 1.35rem;
      font-weight: 700;
    }
  }
</style>
