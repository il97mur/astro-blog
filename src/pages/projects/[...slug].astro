---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projectsCollection = await getCollection('projects');
  return projectsCollection.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}
// 2. When it's time to render, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Layout
  title={`Projects - ${entry.data.title}`}
  metaDescription={entry.data.description}
>
  <main>
    <a class="link back-link" href="/">
      <span>&larr;</span>
      Go back
    </a>

    <div class="case-study">
      <Content />
    </div>
    {entry.data.technologies &&
      <h2 class="technologies-title">
        Technologies
      </h2>
      <ul class="technologies-list">
        {entry.data.technologies.map(tech => (
          <li class="technologies-list__item"> {tech} </li>
        ))}
      </ul>
    }
  </main>
</Layout>

<style lang="scss">
  main {
    max-width: 800px;
    margin: auto;
    padding: 1.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.95rem;
  }
  .case-study {
    margin-top: 1.5rem;

    :global(h1) {
      font-size: 2.25rem;
      font-weight: 800;
      line-height: 1.2;
      margin: 0 0 1.25rem;
    }
    :global(p) {
      font-size: 1.125rem;
      line-height: 1.65;
      color: #333;
      margin: 0 0 1.1rem;
    }
    :global(ul) {
      margin: 0 0 1.1rem;
      padding-left: 1.25rem;
    }
    :global(li) {
      font-size: 1.125rem;
      line-height: 1.65;
      color: #333;
      margin-bottom: 0.4rem;
    }
  }
  .technologies-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 2rem 0 1rem;
  }
  .technologies-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 0;
    padding: 0;

    &__item {
      list-style: none;
      padding: 5px 15px;
      border-radius: 8px;
      background: rgba(var(--accent), 0.2);
    }
  }
</style>