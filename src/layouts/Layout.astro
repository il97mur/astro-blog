---
export interface Props {
  title: string;
  metaDescription?: string;
}

const { title, metaDescription = "The page of my site" } = Astro.props;

import Header from "../components/Header.astro";
import { ViewTransitions } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#5ede9f4d" />
    {metaDescription && <meta name="description" content={metaDescription} />}
    <title>{title}</title>

    <ViewTransitions />
    <Analytics />
  </head>
  <body>
    <Header />
    <slot />
    <SpeedInsights />
  </body>
</html>
<style is:global lang="scss">
  :root {
    --accent: 94, 222, 159;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      #7762da 30%,
      white 60%
    );

    /* Layout tokens */
    --content-width: 880px;
    --page-padding: clamp(1rem, 4vw, 1.5rem);

    /* Fluid type scale: scales continuously with viewport width and stays consistent across pages that share a role. */
    --fs-eyebrow: 1rem;
    --fs-display: clamp(2rem, 1.5rem + 2.2vw, 3rem);
    --fs-h1-case: clamp(1.75rem, 1.4rem + 1.5vw, 2.25rem);
    --fs-h2: clamp(1.35rem, 1.15rem + 1vw, 1.75rem);
    --fs-body: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
  }
  html {
    margin: 0;
    padding: 0;
    font-family: system-ui, sans-serif;
    background-color: #f6f6f6;
  }
  body {
    margin: 0;
  }
  code {
    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;
  }
  .link {
    color: currentColor;
    text-decoration: none;
    transition: all 0.3s ease;

    &:hover {
      color: rgb(var(--accent));
    }
  }
</style>
