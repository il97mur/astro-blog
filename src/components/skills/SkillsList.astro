---
import SkillCard from "./SkillCard.astro";

const skillList = [
  {
    name: 'React',
    level: 9,
  },
  {
    name: 'TypeScript',
    level: 9,
  },
  {
    name: 'Vue.js / Nuxt.js',
    level: 8,
  },
  {
    name: 'Redux Toolkit / RTK Query',
    level: 7,
  },
  {
    name: 'HTML / CSS',
    level: 9,
  },
  {
    name: 'PHP / Laravel',
    level: 4,
  },
  {
    name: 'Node.js',
    level: 3,
  },
]
---
<ul>
  {skillList.map(skill => (
    <SkillCard
      name={skill.name}
      level={skill.level}
    />
  ))}
</ul>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style-type: none;
  }
</style>
