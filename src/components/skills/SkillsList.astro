---
const skillList = [
  "React",
  "TypeScript",
  "Vue.js / Nuxt.js",
  "Redux Toolkit / RTK Query",
  "HTML / CSS",
  "PHP / Laravel",
  "Node.js",
  "Architecture Design (Feature-Sliced Design)",
  "Performance Optimization",
];
---

<ul class="tags-list">
  {skillList.map((skill) => (
    <li class="tags-list__item">{skill}</li>
  ))}
</ul>

<style>
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags-list__item {
    padding: 8px 16px;
    border-radius: 8px;
    background-image: var(--accent-gradient);
    background-size: 400%;
    background-position: 0%;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
  }
</style>
