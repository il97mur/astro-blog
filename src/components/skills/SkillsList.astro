---
const skillList = [
  'React',
  'TypeScript',
  'Vue.js / Nuxt.js',
  'Redux Toolkit / RTK Query',
  'HTML / CSS',
  'PHP / Laravel',
  'Node.js',
]
---
<ul class="tags-list">
  {skillList.map(skill => (
    <li class="tags-list__item">{skill}</li>
  ))}
</ul>

<style>
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags-list__item {
    padding: 6px 14px;
    border-radius: 8px;
    background: rgba(var(--accent), 0.15);
    font-size: 0.95rem;
  }
</style>
