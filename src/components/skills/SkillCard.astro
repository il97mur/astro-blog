---
export interface Props {
  name: string;
  level: number;
}

const { name, level } = Astro.props;
---

<li class="skill-card">
  <span class="skill-card__name">
    {name}
  </span>
  <div class="skill-card__track">
    <div class="skill-card__fill" style={`width: ${level * 10}%`}></div>
  </div>
</li>

<style lang="scss">
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 8px;

    &__name {
      font-size: 1.05rem;
      font-weight: 600;
    }

    &__track {
      height: 6px;
      border-radius: 4px;
      background: #e5e5e5;
      overflow: hidden;
    }

    &__fill {
      height: 100%;
      border-radius: 4px;
      background-image: var(--accent-gradient);
      background-size: 400%;
      background-position: 0%;
    }
  }
</style>
